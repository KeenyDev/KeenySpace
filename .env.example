# Example environment for running the server from source.
# Copy to .env (gitignored), replace every placeholder, then see CONTRIBUTING.md.
# The deployment stack does not use this file: deploy/docker-compose.yml reads
# deploy/.env for secrets and deploy/keenyspace.env for app overrides.

KEENYSPACE_DB__URL=postgresql+asyncpg://postgres:x@localhost:55432/postgres
KEENYSPACE_FS__ROOT=/tmp/keenyspace
KEENYSPACE_AUTO_MIGRATE=false

# OIDC — all seven values are required; the server refuses to start without them.
# These match deploy/docker-compose.yml's reference Authentik.
KEENYSPACE_AUTH__OIDC_ISSUER_URL=http://localhost:9000/application/o/keenyspace/
KEENYSPACE_AUTH__OIDC_CLIENT_ID=keenyspace-cli
KEENYSPACE_AUTH__OIDC_CLIENT_SECRET=replace-me-min-32-bytes-xxxxxxxxxxxx
KEENYSPACE_AUTH__OIDC_REDIRECT_URI=http://localhost:8000/v1/api/auth/callback
KEENYSPACE_AUTH__OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/
KEENYSPACE_AUTH__SESSION_SECRET_KEY=replace-me-min-32-bytes-xxxxxxxxxxxx
KEENYSPACE_AUTH__API_KEY_PEPPER=replace-me-min-32-bytes-xxxxxxxxxxxx

# Group gates. Empty required_group admits any authenticated IdP user;
# an empty admin_group refuses every admin endpoint.
KEENYSPACE_AUTH__REQUIRED_GROUP=
KEENYSPACE_AUTH__ADMIN_GROUP=keenyspace-admins
KEENYSPACE_AUTH__MULTI_WORKER=false

KEENYSPACE_WAL__MAX_ENTRY_BYTES=262144

KEENYSPACE_SERVER__HOST=127.0.0.1
KEENYSPACE_SERVER__PORT=8000
KEENYSPACE_SERVER__LOG_LEVEL=INFO

# Destructive admin backup/restore endpoints; also require admin group membership.
KEENYSPACE_ADMIN_API_ENABLED=0

# Internal Prometheus listener (separate from the API port); 0 disables it.
KEENYSPACE_METRICS_PORT=9100
KEENYSPACE_METRICS_ADDR=127.0.0.1
