# App-only overrides for the keenyspace container.
# Copy to deploy/keenyspace.env (gitignored) and uncomment what you need:
#   cp deploy/keenyspace.env.example deploy/keenyspace.env && chmod 600 deploy/keenyspace.env
#
# Loaded via `env_file:` into the keenyspace service only. Values set explicitly under
# `environment:` in docker-compose.yml win over this file; those (DB URL, OIDC,
# secrets, groups, compile provider/model, LLM API keys, admin API flag, metrics port)
# are configured in deploy/.env instead. Never put Postgres or Authentik secrets here.

# Compile budgets
# KEENYSPACE_COMPILE__MAX_OUTPUT_TOKENS_PER_SPACE=128000
# KEENYSPACE_COMPILE__MAX_OUTPUT_TOKENS_PER_CALL=20000
# KEENYSPACE_COMPILE__DAILY_TOKEN_CEILING=500000
# KEENYSPACE_COMPILE__MAX_INPUT_TOKENS=50000
# KEENYSPACE_COMPILE__MAX_TOOL_CALLS=20
# KEENYSPACE_COMPILE__MAX_SECONDS=180
# KEENYSPACE_COMPILE__MAX_SLICE_BYTES=40000

# Compile scheduling
# KEENYSPACE_COMPILE__DEBOUNCE_SECONDS=30
# KEENYSPACE_COMPILE__BACKSTOP_INTERVAL_MINUTES=15

# WAL
# KEENYSPACE_WAL__MAX_ENTRY_BYTES=262144
# KEENYSPACE_WAL__RETENTION_DAYS=

# Server
# KEENYSPACE_SERVER__LOG_LEVEL=INFO
# KEENYSPACE_SERVER__PUBLIC_URL=https://keenyspace.example.com

# Auth tuning
# KEENYSPACE_AUTH__COOKIE_SECURE=true
# KEENYSPACE_AUTH__API_KEY_GROUP_SNAPSHOT_MAX_AGE_DAYS=30
