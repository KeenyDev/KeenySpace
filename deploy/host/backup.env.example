# Settings for deploy/scripts/scheduled-backup.sh.
# Installed to /etc/keenyspace/backup.env (mode 600) by deploy/host/provision.sh.

# API key (ks_live_...) of a member of the admin group (keenyspace-admins).
# Mint it once as akadmin; see docs/deploy-single-host.md.
KEENYSPACE_BACKUP_API_KEY=

# rclone destination: any configured remote (S3-compatible storage, SFTP, ...),
# e.g. offsite:my-bucket/keenyspace. Use a dedicated path: files older than
# REMOTE_RETENTION_DAYS under it are deleted.
BACKUP_REMOTE=

# BACKUP_DIR=/var/backups/keenyspace
# LOCAL_RETENTION_DAYS=3
# REMOTE_RETENTION_DAYS=30
